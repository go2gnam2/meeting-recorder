rules_version = '2';
// 회의록 레코더 보안 규칙
// 1) 관리자 메일: go2gnam2@gmail.com (firebase-config.js 의 APP_ADMINS 와 같아야 합니다)
// 2) Firebase 콘솔 → Firestore Database → 규칙 탭에 이 파일 내용을 통째로 붙여 넣고 "게시"를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {
    function ADMINS() { return ['go2gnam2@gmail.com']; }

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return verified() && email() in ADMINS(); }
    function accessDoc() { return /databases/$(database)/documents/config/access; }
    function allowed() {
      return isAdmin() || (verified() && exists(accessDoc()) && (
        email() in get(accessDoc()).data.emails ||
        email().split('@')[1] in get(accessDoc()).data.domains));
    }

    // 사용 허가 목록: 허가된 사람은 읽기(권한 확인용), 관리자만 수정
    match /config/access {
      allow read: if allowed();
      allow write: if isAdmin();
    }

    // 사용 요청: 메일 인증된 본인만 자기 요청을 만들고, 관리자가 보고 처리
    match /accessRequests/{uid} {
      allow create, update: if verified() && request.auth.uid == uid && request.resource.data.email == email();
      allow get: if signedIn() && request.auth.uid == uid;
      allow read, delete: if isAdmin();
    }

    // 각자의 회의 기록: 허가된 본인만 읽고 쓸 수 있음
    match /users/{uid}/{document=**} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }
  }
}
